# Saffron & Steam - Environment Variables Template
# Copy this file to '.env' and fill in the values. DO NOT commit actual secrets!

# ==============================================================================
# 1. Firebase Serverless Backend Configurations
# ==============================================================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id_here
FIREBASE_APP_ID=1:your_fcm_sender_id:web:your_app_id
FIREBASE_MEASUREMENT_ID=G-your_measurement_id

# ==============================================================================
# 2. Google Maps Platform Configurations (Android & iOS SDKs)
# ==============================================================================
GOOGLE_MAPS_API_KEY_ANDROID=your_google_maps_android_api_key_here
GOOGLE_MAPS_API_KEY_IOS=your_google_maps_ios_api_key_here

# ==============================================================================
# 3. Razorpay Payment Gateway Keys (Simulated vs Production)
# ==============================================================================
RAZORPAY_KEY_ID_TEST=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET_TEST=your_test_key_secret_here
RAZORPAY_KEY_ID_LIVE=rzp_live_your_live_key_here
RAZORPAY_KEY_SECRET_LIVE=your_live_key_secret_here

# ==============================================================================
# 4. FCM Notifications Configurations
# ==============================================================================
FCM_SERVER_KEY=your_fcm_legacy_server_key_here_if_applicable
FCM_VAPID_KEY=your_fcm_web_push_vapid_key_here

# ==============================================================================
# 5. Store Operational Parameters & Configurations
# ==============================================================================
STORE_PHONE_NUMBER=+912222043751
STORE_WHATSAPP_NUMBER=+919876543210
STORE_ADDRESS=Tea Centre, Resham Bhavan, Veer Nariman Road, Churchgate, Mumbai, Maharashtra 400020
STORE_DELIVERY_RADIUS_KM=10.0
STORE_DELIVERY_CHARGE=30.0
STORE_TAX_RATE=5.0
